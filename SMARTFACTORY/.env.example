FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
LOG_LEVEL=INFO
LOG_FORMAT=console
ENVIRONMENT=development
SERVICE_NAME=SmartFactory2
MQTT_SERVER=mqtt.ohstem.vn
MQTT_PORT=1883
# Uncomment and set for API authentication:
#API_KEY=your_secret_key_here

# ── PCLS Reporting Service ────────────────────────────────────────────────────
# External API that receives color-detection events from the conveyor.
# color_code: red=1, blue=2, yellow=3
PCLS_API_URL=https://api-pcls.splus-software.com.vn
PCLS_DEVICE_ID=raspi-01
# PCLS_TIMEOUT=5
