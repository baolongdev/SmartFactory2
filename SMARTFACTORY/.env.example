# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=production
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console
ENVIRONMENT=production
SERVICE_NAME=SmartFactory2

# ── UART / Serial ─────────────────────────────────────────────────────────────
# Linux/Pi: /dev/ttyACM0 (Arduino/ESP32 USB)
#           /dev/ttyUSB0 (USB-Serial adapter)
#           /dev/ttyAMA0 (Pi GPIO UART)
# Windows:  COM3
UART_PORT=/dev/ttyACM0
UART_BAUDRATE=115200

# ── API Authentication ────────────────────────────────────────────────────────
# Bỏ comment để bảo mật các endpoint write
#API_KEY=your_secret_key_here

# ── PCLS Reporting Service ────────────────────────────────────────────────────
# Nhận sự kiện phát hiện màu từ conveyor (red=1, blue=2, yellow=3)
PCLS_API_URL=https://api-pcls.splus-software.com.vn
PCLS_DEVICE_ID=raspi-01
PCLS_TIMEOUT=5
